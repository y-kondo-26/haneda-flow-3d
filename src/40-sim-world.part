// =====================================================================
// 40 world : 便スケジュールと需要（旅客・手荷物）を乱数シードから作る。
// 2 つのシミュレーション（従来運用 / AI 最適化）は同じ World を読むので、
// 旅客ごとの到着時刻・所要時間・タグの読取乱数は両モードで同一になる。
// =====================================================================
function mulberry32(a) {
  return function () { a |= 0; a = a + 0x6D2B79F5 | 0; let t = Math.imul(a ^ a >>> 15, 1 | a); t = t + Math.imul(t ^ t >>> 7, 61 | t) ^ t; return ((t ^ t >>> 14) >>> 0) / 4294967296; };
}
const lerp = (a, b, t) => a + (b - a) * t;
const clamp = (v, a, b) => v < a ? a : v > b ? b : v;
const bankDensity = t => { const g = (m, s, h) => h * Math.exp(-0.5 * ((t - m) / s) ** 2); return Math.min(1, g(470, 70, 1) + g(750, 80, 0.45) + g(1100, 85, 0.95) + g(1385, 45, 0.8)); };
// 出発の何分前に空港へ着くか（58〜136 分に山、12% は 136〜185 分の早着）
const leadTime = r => r() < 0.12 ? 136 + 49 * r() : 58 + 78 * (r() + r() + r()) / 3;
const gammaish = (r, mean) => mean * (0.35 + 1.3 * (r() + r()) / 2);   // 平均 mean、0.35〜1.65 倍

function makeFlight(world, gate, arr, dep, opt = {}) {
  const r = mulberry32(world.seed * 7919 + world.flights.length * 104729 + 17);
  const wide = r() < 0.72;
  const paxOut = opt.pax || Math.round(wide ? 232 + 96 * r() : 150 + 34 * r());
  const f = {
    id: world.flights.length, gate, arr, dep,
    code: 'XX ' + (101 + ((world.flights.length * 37 + gate * 211) % 880)),
    wide, paxOut, paxIn: arr == null ? 0 : Math.round(paxOut * (0.8 + 0.3 * r())),
    island: clamp(Math.round(gate * 5 / 7 + (r() * 2.4 - 1.2)), 0, 5),
    lateralFix: gate === 8 ? 11 : gate + Math.floor(gate / 2),   // 固定割当（12 本のうち 8 本を使う。臨時便は 12 番）
    xb: [],
    extra: !!opt.extra, nLocal: 0, nBags: 0, fcErr: 0.9 + 0.2 * r(),
  };
  world.flights.push(f);
  // ---- 出発旅客 ----
  const xferShare = 0.10 + 0.10 * r();
  for (let i = 0; i < paxOut; i++) {
    const xfer = r() < xferShare;
    const p = {
      id: world.paxSeq++, f: f.id, xfer, bags: 0, bagU: null,
      tArr: 0, door: 0, off: r() * 2 - 1,
      svcDrop: gammaish(r, P.dropSvcMean), svcSec: gammaish(r, P.secSvcMean), svcImm: gammaish(r, P.immSvcMean),
      uComply: r(), seatX: LAY.gates[gate].x + (r() * 2 - 1) * (gate === 8 ? 11 : 16), seatZ: -10.5 + r() * 15,
    };
    if (xfer) {
      p.tArr = dep - (48 + 100 * r()); p.door = -1;
      p.fromGate = (gate + 1 + Math.floor(r() * 7)) % 8;
      if (r() < 0.8) { const xb = { t: dep - (r() < 0.07 ? 8 + 36 * r() : 62 + 190 * r() * r()), f: f.id, uEds: r(), uRead: r(), uMis: r(), uHold: r() }; world.xbags.push(xb); f.xb.push(xb); }
    } else {
      p.tArr = dep - leadTime(r);
      const d = r(); let acc = 0; for (let k = 0; k < 4; k++) { acc += LAY.doorShare[k]; if (d < acc) { p.door = k; break; } }
      const hb = r();
      p.bags = hb < 0.28 ? 0 : hb < 0.86 ? 1 : 2;
      if (p.bags) { p.bagU = []; for (let b = 0; b < p.bags; b++) p.bagU.push({ uEds: r(), uRead: r(), uMis: r(), uHold: r() }); p.svcDrop *= (1 + 0.45 * (p.bags - 1)); }
      f.nLocal++; f.nBags += p.bags;
    }
    if (p.tArr < DAY0 + 1) p.tArr = DAY0 + 1 + 20 * r();
    if (opt.minT && p.tArr < opt.minT) p.tArr = opt.minT + 6 * r();
    world.pax.push(p);
  }
  return f;
}

function buildWorld(seed) {
  const world = { seed, flights: [], pax: [], xbags: [], paxSeq: 0, leadSamples: [] };
  const r = mulberry32(seed);
  for (let g = 0; g < 8; g++) {
    let dep = 424 + ((g * 5) % 8) * 13 + r() * 8, arr = null;
    while (dep < DAY1 - 14) {
      makeFlight(world, g, arr, dep);
      const gap = lerp(128, 14, Math.pow(bankDensity(dep + 45), 0.8)) * (0.85 + 0.3 * r());
      arr = dep + gap; dep = arr + 76 + 26 * r();
    }
  }
  world.pax.sort((a, b) => a.tArr - b.tArr);
  world.xbags.sort((a, b) => a.t - b.t);
  const rl = mulberry32(seed ^ 0x5bd1e995);
  for (let i = 0; i < 240; i++) world.leadSamples.push(leadTime(rl));
  world.rebuildForecast = () => buildForecast(world);
  buildForecast(world);
  world.fcIsland0 = world.fcIsland.map(a => a.slice()); world.fcTotal0 = world.fcTotal.slice(); world.rosterCache = {};
  return world;
}

// AI が使う到着予測: 便スケジュール × 既知の来港パターン（実際の乱数は見ない）。5 分刻み。
const FC_BIN = 5, FC_N = Math.ceil((DAY1 - DAY0) / FC_BIN) + 4;
function buildForecast(world) {
  const fc = world.fcIsland = Array.from({ length: 6 }, () => new Float32Array(FC_N));
  world.fcTotal = new Float32Array(FC_N);
  const n = world.leadSamples.length;
  for (const f of world.flights) {
    const exp = f.paxOut * 0.85 * f.fcErr / n;       // ローカル旅客の見込み（±10% の誤差つき）
    for (const lead of world.leadSamples) {
      const b = Math.floor((Math.max(DAY0 + 1, f.dep - lead) - DAY0) / FC_BIN);
      if (b >= 0 && b < FC_N) { fc[f.island][b] += exp; world.fcTotal[b] += exp; }
    }
  }
}

// シナリオ「臨時便の追加」: 空いているゲートに便を足し、旅客・手荷物を需要に混ぜる
function addExtraFlight(world, now) {
  const dep = now + 105;
  if (dep > DAY1 - 5 || world.flights.some(f => f.gate === 8 && Math.abs(f.dep - dep) < 140)) return null;   // オープンスポットは 1 か所
  const best = 8;
  const before = world.pax.length, xb = world.xbags.length;
  const f = makeFlight(world, best, now + 24, dep, { extra: true, pax: 310, minT: now + 0.5 }); f.paxIn = 0;
  f.code = 'XX 9' + String(10 + (world.flights.length % 80));
  const added = world.pax.splice(before), addedX = world.xbags.splice(xb);
  for (const p of added) { if (p.xfer) p.tArr = Math.max(p.tArr, now + 30 + 20 * (p.off + 1)); }
  for (const b of addedX) b.t = Math.max(b.t, now + 30);
  world.pax.push(...added); world.pax.sort((a, b) => a.tArr - b.tArr);
  world.xbags.push(...addedX); world.xbags.sort((a, b) => a.t - b.t);
  world.rebuildForecast();
  return f;
}
