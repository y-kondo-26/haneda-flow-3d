// =====================================================================
// 44 sim (手荷物 1) : 預け入れ → コレクター → インライン EDS → ソーター投入
// =====================================================================
const B = { MOVE: 1, EDS_Q: 2, L2: 3, IND_Q: 4, LOOP: 5, MES_Q: 6, MES: 7, EBS: 8, HOLD: 9, LAT: 10, TRAIN: 11, ARR: 12, CAR: 13, GONE: 99 };
const NEXT = { EDS_Q: 1, EDS_OUT: 2, INDUCT: 3, MES_Q: 4, EBS_IN: 5, HOLD_IN: 6, LAT_IN: 7, CAR: 8, REMOVE: 9, EBS_OUT: 10 };
const BY = 0.95;                                     // ベルト上の手荷物の高さ
const edsSlot = (line, i, out) => {
  const ex = BHS.edsX[line];
  if (i < 3) { out.x = ex; out.z = BHS.zEdsIn + 0.6 + i * 1.05; }
  else { const j = i - 3, side = j & 1 ? 1 : -1; out.x = ex + side * (1.4 + (j >> 1) * 1.38); out.z = 50 + side * 0.7; }
  return out;
};

Sim.prototype.initBags = function () {
  this.bags = []; this.bagSeq = 0; this.xbPtr = 0; this.loopN = 0;
  this.eds = [0, 1, 2].map(() => ({ q: [], free: 0, indQ: [], n: 0 }));
  this.mes = { q: [], free: new Float64Array(P.mesStations) };
  this.ebs = { cells: new Array(BHS.ebs.cols * BHS.ebs.rows * BHS.ebs.levels).fill(null), n: 0 };
  this.holdN = 0; this.lat = BHS.lateralX.map(() => ({ f: -1, n: 0, res: 0, slots: [] }));
  this.tugs = Array.from({ length: P.tugs }, (_, i) => ({ id: i, st: 0, x: -160 + i * 4.6, z: -9, hx: 1, hz: 0, path: null, s: 0, len: 0, f: null, bags: [], tEnd: 0, kind: 0 }));
  this.tugReq = [];
};

Sim.prototype.newBag = function (f, u, x, y, z, xfer, uid) {
  const b = { id: this.bagSeq++, uid, f, u, x, y, z, st: B.MOVE, wp: null, next: 0, spd: SPD.belt, t0: this.t, store: 0, tS: 0,
    line: 0, read: false, mis: false, missed: false, dest: 0, uDest: -1, uLoop: 0, dist: 0, laps: 0, lat: -1, slot: -1, tEnd: 0, c: 0, xfer, tug: null, k: 0, tRoute: 0 };
  this.bags.push(b); const fs = this.flightState(f.id); fs.bagsIn++; this.kpi.bagsIn++; this.kpi.bagArr[this.bin15()]++;
  return b;
};
// EDS ラインの選択。
// 従来運用: チェックイン島ごとの固定経路。待ちが 60 個を超えたら、待ちの少ない別ラインへあふれさせる（しきい値による固定ルール）。
//           ラインが停止したときは、固定の迂回先（隣のライン）へ流す。
// AI 最適化: 手荷物ごとに、待ち個数と搬送距離から所要時間が最短のラインを選ぶ。
Sim.prototype.pickEds = function (x, natural) {
  // 停止は、経路を切り替えるまで（従来運用 = 係員の操作まで 10 分、AI 最適化 = 自動検知まで 1.5 分）は反映されない
  const down = this.t >= this.scn.edsSwitchAt ? this.scn.edsDown : -1, load = l => this.eds[l].q.length + this.eds[l].n;
  if (this.mode === 0) {
    let line = natural;
    if (natural === down) line = (natural + 1) % 3;
    if (load(line) > P.base.edsOverflow) { let best = line; for (let l = 0; l < 3; l++) if (l !== down && load(l) < load(best) - 12) best = l; line = best; }
    return line;
  }
  let best = natural === down ? (natural + 1) % 3 : natural, bc = 1e9;
  for (let l = 0; l < 3; l++) {
    if (l === down) continue;
    const cost = load(l) * P.edsSvc + Math.abs(BHS.edsX[l] - x) / SPD.belt + (l === natural ? -0.25 : 0);
    if (cost < bc) { bc = cost; best = l; }
  }
  if (best !== natural) this.kpi.rebalanced++;
  return best;
};
Sim.prototype.dropBags = function (a, isl, k) {
  const kp = kioskPos(isl, k), ix = LAY.islands[isl].x, f = a.f;
  for (let i = 0; i < a.p.bags; i++) {
    const b = this.newBag(f, a.p.bagU[i], kp.x + (k % 2 ? -1.6 : 1.6), YU + BY, kp.z + i * 0.8, false, a.p.id * 4 + i);
    const line = b.line = this.pickEds(ix, isl >> 1), ex = BHS.edsX[line], zc = ex >= ix ? 50.7 : 49.3;
    this.eds[line].n++;
    b.wp = [[ix, YU + BY, kp.z + i * 0.8], [ix, YU + BY, LAY.islands[isl].z0 - 0.5], [ix, BY, zc + 1.2], [ix, BY, zc], [ex + (ex >= ix ? -1 : 1), BY, zc], [ex, BY, BHS.zEdsIn + 3]];
    b.next = NEXT.EDS_Q;
  }
};
// 乗り継ぎ手荷物: 到着機から降ろした手荷物を東側の投入口からソーターへ入れる（EDS は出発地で検査済みの扱い）
Sim.prototype.spawnXferBags = function () {
  const W = this.world;
  while (this.xbPtr < W.xbags.length && W.xbags[this.xbPtr].t <= this.t) {
    const xb = W.xbags[this.xbPtr++], f = W.flights[xb.f];
    if (f.dep <= this.t) continue;
    if (xb.uid === undefined) xb.uid = 4000000 + (W.xbSeq = (W.xbSeq || 0) + 1);
    const b = this.newBag(f, xb, BHS.xferIn.x + 6, BY, BHS.xferIn.z + 8, true, xb.uid);
    b.wp = [[BHS.xferIn.x, BY, BHS.xferIn.z + 8], [BHS.xferIn.x, BY, BHS.xferIn.z], [BHS.loop.a - 4, BY, BHS.loop.zc + BHS.loop.r + 0.6]]; b.next = NEXT.INDUCT; b.line = 3;
  }
};
Sim.prototype.moveBag = function (b, dt) {
  let stp = b.spd * dt;
  while (b.wp && b.wp.length) {
    const w = b.wp[0], dx = w[0] - b.x, dy = w[1] - b.y, dz = w[2] - b.z, d = Math.hypot(dx, dy, dz);
    if (d > stp) { const k = stp / d; b.x += dx * k; b.y += dy * k; b.z += dz * k; return false; }
    b.x = w[0]; b.y = w[1]; b.z = w[2]; stp -= d; b.wp.shift();
  }
  return true;
};

Sim.prototype.stepEds = function (dt) {
  const t = this.t;
  if (this.scn.edsDown >= 0 && t >= this.scn.edsUntil) { this.addLog('scn', `インライン EDS ${this.scn.edsDown + 1} 号機が復旧しました。`); this.scn.edsDown = -1; }
  for (let l = 0; l < 3; l++) {
    const e = this.eds[l];
    if (l !== this.scn.edsDown && e.q.length && e.free <= t && e.indQ.length < 8) {
      let qi = 0;
      if (this.mode === 1 && e.q.length > 10) {       // AI 最適化: 滞留時は合流部で出発の早い便の手荷物を先に通す
        const lim = Math.min(e.q.length, 60); for (let i = 1; i < lim; i++) if (e.q[i].f.dep < e.q[qi].f.dep - 12) qi = i;
        if (qi) this.kpi.prioritized++;
      }
      const b = qi ? e.q.splice(qi, 1)[0] : e.q.shift(), start = b.tS <= e.free ? Math.max(e.free, t - dt) : t;
      e.free = start + P.edsSvc;
      const ex = BHS.edsX[l]; b.st = B.MOVE; b.spd = SPD.belt; b.wp = [[ex, BY, BHS.zEdsIn], [ex, BY, BHS.zEdsOut]]; b.next = NEXT.EDS_OUT;
    }
    for (let i = 0; i < e.q.length; i++) { const b = e.q[i]; edsSlot(l, i, _slot); b.x += (_slot.x - b.x) * Math.min(1, dt * 14); b.z += (_slot.z - b.z) * Math.min(1, dt * 14); b.c = i > 18 ? 1 : 0; }
    // ソーターへの投入（トレイに空きがあるときだけ）
    while (e.indQ.length && this.loopN < P.loopCap) { const b = e.indQ.shift(); this.induct(b, BHS.uEds[l]); }
    for (let i = 0; i < e.indQ.length; i++) { const b = e.indQ[i]; b.x = BHS.edsX[l]; b.z = BHS.loop.zc + BHS.loop.r + 1 + i * 0.6; }
  }
};

// 手荷物が経路の終点に着いたときの処理
Sim.prototype.bagArrive = function (b) {
  const t = this.t, e = this.eds[b.line];
  switch (b.next) {
    case NEXT.EDS_Q: b.st = B.EDS_Q; b.tS = t; e.q.push(b); break;
    case NEXT.EDS_OUT: {
      const ex = BHS.edsX[b.line], u = b.u.uEds;
      if (u < P.edsL3 + P.edsL2) {                    // 画像判定（Level 2）/ 開披検査（Level 3）
        b.st = B.L2; b.tEnd = t + (u < P.edsL3 ? P.edsL3Time : P.edsL2Time); b.x = ex + 3.2 + (b.id % 4) * 0.9; b.z = BHS.zEdsOut - 1 - ((b.id >> 2) % 3) * 0.9; b.c = 1;
      } else { b.wp = [[ex, BY, BHS.loop.zc + BHS.loop.r + 0.6]]; b.next = NEXT.INDUCT; }
      break;
    }
    case NEXT.INDUCT:
      if (b.line < 3) { e.n--; e.indQ.push(b); b.st = B.IND_Q; }
      else if (this.loopN < P.loopCap) this.induct(b, BHS.uXfer); else { b.wp = [[b.x, BY, b.z]]; }
      break;
    default: this.bagArrive2(b);
  }
};
