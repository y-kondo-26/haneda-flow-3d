// =====================================================================
// 72 ui (ログ・出発便・操作) : モード切替、時間、シナリオ、表示の切替
// =====================================================================
let logSig = '', logView = 'log';
function updateLog() {
  const sim = sims[active], kinds = active ? ['ai', 'scn'] : ['ops', 'scn'];
  const sig = active + ':' + sim.log.length + ':' + (sim.log.length ? sim.log[sim.log.length - 1].t : 0);
  if (sig === logSig) return; logSig = sig;
  // 舞台の上の 1 行表示: 表示中のモードで最後に起きた判断・事象
  let last = null; for (let i = sim.log.length - 1; i >= 0; i--) if (kinds.includes(sim.log[i].kind)) { last = sim.log[i]; break; }
  const tk = $('ticker'); tk.hidden = !last;
  if (last) { tk.dataset.kind = last.kind; $('tickKind').textContent = last.kind === 'ai' ? 'AI の判断' : last.kind === 'scn' ? '事象' : '係員の対応'; $('tickTime').textContent = hhmm(last.t); $('tickText').textContent = last.text; }
  const rows = []; for (let i = sim.log.length - 1; i >= 0 && rows.length < 40; i--) { const l = sim.log[i]; if (kinds.includes(l.kind)) rows.push(`<li class="${l.kind}"><time>${hhmm(l.t)}</time><p>${l.text}</p></li>`); }
  $('log').innerHTML = rows.length ? rows.join('') : `<li class="empty">${active ? 'AI の判断はまだありません。' : '係員の対応はまだありません。'}</li>`;
}
function updateFids() {
  const sim = sims[active], t = sim.t, list = world.flights.filter(f => f.dep > t - 12).sort((a, b) => a.dep - b.dep).slice(0, 9);
  $('fids').innerHTML = list.map(f => {
    const fs = sim.flightState(f.id), g = LAY.gates[f.gate]; let st, warn = false;
    if (fs.closed) { warn = fs.bagsMissed > 0; st = warn ? `出発・積み残し <b>${fs.bagsMissed}</b> 個` : '出発・全量搭載'; }
    else if (t >= f.dep - P.boardStart) st = `搭乗 <b>${fs.boarded}/${f.paxOut}</b>・搭載 <b>${fs.bagsLoaded}/${fs.bagsIn}</b>`;
    else st = `預かり <b>${fs.bagsIn}</b> 個・搭載 <b>${fs.bagsLoaded}</b>`;
    return `<li><span class="num">${hhmm(f.dep)}</span><span class="num">${f.code}</span><span class="g">${g.no}</span><span class="st${warn ? ' warn' : ''}">${st}</span></li>`;
  }).join('') || '<li>本日の出発便は終了しました。</li>';
}
let toastTimer = 0;
function toast(text, kind) { const el = $('toast'); el.textContent = text; el.dataset.kind = kind || 'info'; el.classList.add('on'); clearTimeout(toastTimer); toastTimer = setTimeout(() => el.classList.remove('on'), 4200); }

function setMode(m, quiet) {
  active = m; $('modeBase').setAttribute('aria-checked', m === 0); $('modeAi').setAttribute('aria-checked', m === 1);
  $('modeBase').tabIndex = m === 0 ? 0 : -1; $('modeAi').tabIndex = m === 1 ? 0 : -1;
  $('thBase').classList.toggle('on', m === 0); $('thAi').classList.toggle('on', m === 1);
  $('logTitle').textContent = m ? 'AI の判断ログ' : '運用ログ（従来運用）';
  $('clockSub').textContent = m ? 'AI 最適化を表示中' : '従来運用を表示中';
  if (!quiet && !reduceMotion.matches) { const fl = $('worldFlash'); fl.classList.remove('on'); void fl.offsetWidth; fl.classList.add('on'); }
  logSig = ''; refreshUi(true);
}
function refreshUi(force) {
  $('clock').textContent = hhmm(sims[0].t);
  updateKpi(); updateCharts(); updateLog(); if (logView === 'fids') updateFids();
  updateLiveLabels(sims[active], world);
  if (force) { updateHeat(sims[active], true); updateFlows(sims[active]); updateAircraft(sims[active], world); updateTrack(sims[active]); }
  for (const [id, on] of [['scnEds', sims[0].scn.edsDown >= 0], ['scnCp', sims[0].cp.some(c => c.limit < 99)], ['scnExtra', world.flights.some(f => f.extra && f.dep > sims[0].t)]]) {
    const b = $(id); b.dataset.active = on ? '1' : '0'; b.disabled = on || sims[0].t > DAY1 - 130;
  }
}
function setPlaying(p) { playing = p; $('playIcon').setAttribute('d', p ? 'M2 1h3v10H2zM7 1h3v10H7z' : 'M2.5 1l8 5-8 5z'); $('btnPlay').setAttribute('aria-label', p ? '一時停止' : '再生'); }
function resetSim(until) {
  world = buildWorld(SEED); sims = [new Sim(world, 0), new Sim(world, 1)];
  for (let t = DAY0; t < until - 1e-6; t += 0.05) { sims[0].step(0.05); sims[1].step(0.05); }
  logSig = '';
}
// 起動時: 05:00 から最初に見せる時刻まで、画面を固めないように小分けにして計算する
async function prewarm(until, onProgress) {
  world = buildWorld(SEED); sims = [new Sim(world, 0), new Sim(world, 1)];
  let t = DAY0;
  while (t < until - 1e-6) {
    const t0 = performance.now();
    while (t < until - 1e-6 && performance.now() - t0 < 70) { for (let i = 0; i < 20 && t < until - 1e-6; i++, t += 0.1) { sims[0].step(0.1); sims[1].step(0.1); } }   // 起動時だけ 0.1 分刻み
    onProgress((t - DAY0) / (until - DAY0));
    await new Promise(r => { const ch = new MessageChannel(); ch.port1.onmessage = () => r(); ch.port2.postMessage(0); });   // タイマーと違い、裏のタブでも間引かれない
  }
  logSig = '';
}
function placeControls() {       // スマホ幅では、事象・表示の操作と凡例を下のシートへ移す
  if (isNarrow.matches) { $('sheetSlot').append($('ctlBars'), $('legend')); }
  else { $('dockSlot').append($('ctlBars')); $('stageWrap').insertBefore($('legend'), $('toast')); }
  $('legend').open = isNarrow.matches || (wrapEl.clientWidth >= 900 && wrapEl.clientHeight >= 700);      // 舞台が狭いときは凡例をたたんでおく
}
function pressGroup(ids, on) { for (const id of ids) $(id).setAttribute('aria-pressed', id === on); }

function bindUi() {
  buildKpiTable(); placeControls(); isNarrow.addEventListener('change', () => { placeControls(); onResize(); });
  $('modeBase').addEventListener('click', () => setMode(0)); $('modeAi').addEventListener('click', () => setMode(1));
  $('modeSwitch').addEventListener('keydown', e => { if (['ArrowLeft', 'ArrowRight', 'ArrowUp', 'ArrowDown'].includes(e.key)) { e.preventDefault(); setMode(1 - active); (active ? $('modeAi') : $('modeBase')).focus(); } });
  $('btnPlay').addEventListener('click', () => setPlaying(!playing));
  for (const id of ['spd1', 'spd2', 'spd4']) $(id).addEventListener('click', e => { speed = +e.currentTarget.dataset.spd; pressGroup(['spd1', 'spd2', 'spd4'], id); if (!playing) setPlaying(true); });
  $('btnRestart').addEventListener('click', () => { resetSim(DAY0 + 2); setPlaying(true); refreshUi(true); toast('05:00 から計算をやり直します。'); });
  $('winAll').addEventListener('click', () => { win60 = false; pressGroup(['winAll', 'win60'], 'winAll'); updateKpi(); });
  $('win60').addEventListener('click', () => { win60 = true; pressGroup(['winAll', 'win60'], 'win60'); updateKpi(); });
  $('logTabLog').addEventListener('click', () => { logView = 'log'; pressGroup(['logTabLog', 'logTabFids'], 'logTabLog'); $('log').hidden = false; $('fids').hidden = true; });
  $('logTabFids').addEventListener('click', () => { logView = 'fids'; pressGroup(['logTabLog', 'logTabFids'], 'logTabFids'); $('log').hidden = true; $('fids').hidden = false; updateFids(); });
  for (const b of $('tabs').querySelectorAll('button')) b.addEventListener('click', () => {
    $('panel').dataset.tab = b.dataset.tab; for (const o of $('tabs').querySelectorAll('button')) o.setAttribute('aria-selected', o === b);
    requestAnimationFrame(() => { updateCharts(); });
  });
  // ---- シナリオ: 両方のシミュレーションへ同じ時刻に入れる ----
  $('scnEds').addEventListener('click', () => { for (const s of sims) s.scenarioEds(1, 45); toast('インライン EDS 2 号機を 45 分間停止しました。', 'scn'); goCam('bhs'); refreshUi(); });
  $('scnCp').addEventListener('click', () => { for (const s of sims) s.scenarioCp(1, 30); toast('保安検査場 B を 30 分間、1 レーンに制限しました。', 'scn'); goCam('sec'); refreshUi(); });
  $('scnExtra').addEventListener('click', () => {
    const f = addExtraFlight(world, sims[0].t);
    if (!f) { toast('オープンスポットが空いていないため、臨時便を追加できません。'); return; }
    for (const s of sims) s.scenarioExtra(f); toast(`臨時便 ${f.code}（${hhmm(f.dep)} 発、${f.paxOut} 名）を追加しました。`, 'scn'); refreshUi();
  });
  // ---- 表示の切替 ----
  const toggle = (id, fn) => $(id).addEventListener('click', e => { const on = e.currentTarget.getAttribute('aria-pressed') !== 'true'; e.currentTarget.setAttribute('aria-pressed', on); fn(on); });
  toggle('layHeat', on => { HEAT.mesh.visible = on; if (on) updateHeat(sims[active], true); });
  toggle('layLabel', on => { labelsOn = on; updateLabelVisibility(); });
  toggle('layPath', on => { gPath.visible = on; });
  toggle('layRoof', on => { upperGhostTarget = on ? 1 : 0; if (reduceMotion.matches) { upperGhost = upperGhostTarget; setUpperOpacity(upperGhost); applyGhostToFlows(); } });
}
