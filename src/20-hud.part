<div id="app">
  <div id="stageWrap">
    <canvas id="stage" role="img" aria-label="羽田空港をモデルにしたターミナルの 3D 構想図。上階に旅客の流れ、下階に手荷物の流れを表示します。"></canvas>
    <div id="labels"></div>
    <div id="worldFlash"></div>
    <div id="topBar">
    <header id="ident">
      <div class="code"><b>HND</b><span>RJTT</span></div>
      <div class="ttl"><h1>羽田フローツイン</h1><p class="sub">旅客と手荷物の流れを 2 つの運用で同時に計算</p></div>
      <div class="clock"><div id="clock" class="num">--:--</div><span id="clockSub">シミュレーション時刻</span></div>
    </header>
    <div id="modeSwitch" role="radiogroup" aria-label="表示する運用モード">
      <button id="modeBase" type="button" role="radio" aria-checked="false">従来運用<small>固定の計画と事後の対応</small></button>
      <button id="modeAi" type="button" role="radio" aria-checked="true">AI 最適化<small>予測して先に手配する</small></button>
    </div>
    </div>
    <div id="ticker" hidden><span id="tickKind"></span><time id="tickTime" class="num"></time><p id="tickText"></p></div>
    <details id="legend" open>
      <summary id="legendSum">凡例</summary>
      <h3>旅客（上階）</h3>
      <ul>
        <li><i class="p" style="background:var(--pax)"></i>移動中・搭乗待ち</li>
        <li><i class="p" style="background:var(--pax-q)"></i>待ち行列で 3 分以上</li>
        <li><i class="p" style="background:var(--pax-x)"></i>乗り継ぎ</li>
        <li><i class="p" style="background:var(--pax-arr)"></i>到着</li>
      </ul>
      <h3>手荷物（下階）</h3>
      <ul>
        <li><i class="b" style="background:var(--bag)"></i>タグ読取済み</li>
        <li><i class="b" style="background:var(--bag-re)"></i>再循環・滞留・仮置き</li>
        <li><i class="b" style="background:var(--bag-ng)"></i>読取不良・ミスソート・積み残し</li>
        <li><i class="b" style="background:var(--bag-ebs)"></i>EBS で保管中</li>
      </ul>
      <div class="heat"><span>混雑 低</span><i></i><span>高</span></div>
    </details>
    <div id="toast" role="status" aria-live="polite"></div>
    <div id="caption" hidden><span class="step" id="capStep"></span><b id="capTitle"></b><span id="capText"></span></div>
    <div id="dock">
      <div class="bar" id="camBar" role="group" aria-label="カメラ">
        <button class="chip" type="button" id="camAll" data-cam="all" aria-pressed="true">全景</button>
        <button class="chip" type="button" id="camLobby" data-cam="lobby" aria-pressed="false">出発ロビー</button>
        <button class="chip" type="button" id="camSec" data-cam="sec" aria-pressed="false">保安検査場</button>
        <button class="chip" type="button" id="camBhs" data-cam="bhs" aria-pressed="false">手荷物仕分け</button>
        <button class="chip" type="button" id="camApron" data-cam="apron" aria-pressed="false">エプロン</button>
        <span class="sep"></span>
        <button class="chip" type="button" id="btnTour" aria-pressed="false">自動ツアー</button>
      </div>
      <div class="bar" id="timeBar" role="group" aria-label="時間">
        <button class="chip" type="button" id="btnPlay" aria-label="一時停止"><svg viewBox="0 0 12 12" aria-hidden="true"><path id="playIcon" d="M2 1h3v10H2zM7 1h3v10H7z"/></svg></button>
        <span class="cap">1 秒あたり</span>
        <button class="chip num" type="button" id="spd1" data-spd="1" aria-pressed="true">1 分</button>
        <button class="chip num" type="button" id="spd2" data-spd="2" aria-pressed="false">2 分</button>
        <button class="chip num" type="button" id="spd4" data-spd="4" aria-pressed="false">4 分</button>
        <span class="sep"></span>
        <button class="chip" type="button" id="btnRestart">05:00 からやり直す</button>
      </div>
      <div id="dockSlot">
        <div id="ctlBars">
          <div class="bar" id="scnBar" role="group" aria-label="シナリオを入れる">
            <span class="cap">事象を入れる</span>
            <button class="chip scn" type="button" id="scnEds">EDS 2 号機が停止</button>
            <button class="chip scn" type="button" id="scnExtra">臨時便を追加</button>
            <button class="chip scn" type="button" id="scnCp">検査場 B の機器が故障</button>
          </div>
          <div class="bar" id="layBar" role="group" aria-label="表示">
            <span class="cap">表示</span>
            <button class="chip" type="button" id="layHeat" aria-pressed="true">混雑</button>
            <button class="chip" type="button" id="layLabel" aria-pressed="true">ラベル</button>
            <button class="chip" type="button" id="layPath" aria-pressed="true">手荷物の経路線</button>
            <button class="chip" type="button" id="layRoof" aria-pressed="false">上階を透かす</button>
          </div>
        </div>
      </div>
    </div>
    <div id="boot"><div><p id="bootMsg">3D ライブラリを読み込んでいます</p><div id="bootTrack"><i id="bootBar"></i></div></div></div>
  </div>

  <aside id="panel" data-tab="kpi" aria-label="運用の指標">
    <div id="tabs" role="tablist">
      <button type="button" role="tab" id="tabKpi" data-tab="kpi" aria-selected="true">指標</button>
      <button type="button" role="tab" id="tabChart" data-tab="chart" aria-selected="false">グラフ</button>
      <button type="button" role="tab" id="tabLog" data-tab="log" aria-selected="false">ログ・便</button>
      <button type="button" role="tab" id="tabCtl" data-tab="ctl" aria-selected="false">操作</button>
    </div>
    <div id="panelBody">
      <section class="sec" id="secKpi">
        <div id="headline"><p id="hlLead">AI 最適化の効果（同じ需要・同じ乱数での実測）</p><strong id="hlMain">計測中</strong><p id="hlSub"></p></div>
        <h2 style="margin-top:12px">従来運用と AI 最適化の比較
          <span class="seg" role="group" aria-label="集計範囲"><button type="button" id="winAll" aria-pressed="true">05:00 から累計</button><button type="button" id="win60" aria-pressed="false">直近 60 分</button></span></h2>
        <table class="kpi" id="kpiTable">
          <thead><tr><th scope="col"></th><th scope="col" id="thBase">従来</th><th scope="col" id="thAi" class="ai">AI</th><th scope="col">差</th></tr></thead>
          <tbody id="kpiBody"></tbody>
        </table>
      </section>
      <section class="sec" id="secChart">
        <h2>15 分ごとの推移 <span>縦線 = 現在時刻</span></h2>
        <div class="chart"><p class="ck"><span><i class="bar" style="background:var(--pax)"></i>旅客の到着（人/15分）</span><span><i class="dash" style="border-color:var(--ink-3)"></i>AI が使う到着予測</span></p><canvas id="chDemand" role="img" aria-label="15 分ごとの旅客到着数と到着予測"></canvas></div>
        <div class="chart" style="margin-top:8px"><p class="ck"><span><i style="border-color:var(--base-c)"></i>従来運用</span><span><i style="border-color:var(--ai-c)"></i>AI 最適化</span><span>保安検査の平均待ち（分）</span></p><canvas id="chWait" role="img" aria-label="15 分ごとの保安検査の平均待ち時間。従来運用と AI 最適化"></canvas></div>
        <div class="chart" style="margin-top:8px"><p class="ck"><span><i style="border-color:var(--base-c)"></i>従来運用</span><span><i style="border-color:var(--ai-c)"></i>AI 最適化</span><span>手荷物の処理時間（分）</span></p><canvas id="chBag" role="img" aria-label="15 分ごとの手荷物の処理時間。従来運用と AI 最適化"></canvas></div>
      </section>
      <section class="sec" id="secLog">
        <h2><span id="logTitle" style="font-weight:700;color:var(--ink-2);letter-spacing:.08em;font-size:11px">AI の判断ログ</span>
          <span class="seg" id="logTabs" role="group" aria-label="表示の切替"><button type="button" id="logTabLog" aria-pressed="true">ログ</button><button type="button" id="logTabFids" aria-pressed="false">出発便</button></span></h2>
        <ul id="log" aria-live="off"></ul>
        <ul id="fids" hidden></ul>
      </section>
      <section class="sec" id="secCtl"><div id="sheetSlot"></div></section>
    </div>
    <p id="note">シミュレーションの値は架空の設定に基づくもので、羽田空港の実際のレイアウト・運用データではありません。<span>便名・ゲート・施設の配置は構想図です。歩行と搬送の速さは、表示のために実際より遅くしています。</span></p>
  </aside>
</div>
<script>
// three.js を読み込めなかった場合に、起動中の表示のまま止まらないようにする
window.addEventListener('error', function (e) { var b = document.getElementById('boot'), m = document.getElementById('bootMsg'); if (b && !b.hidden) m.textContent = '表示の準備中にエラーが起きました: ' + (e.message || '不明なエラー'); });
setTimeout(function () { var b = document.getElementById('boot'), m = document.getElementById('bootMsg'); if (b && !b.hidden && m.textContent.indexOf('読み込んでいます') >= 0) m.textContent = '3D ライブラリ（three.js）を読み込めていません。ネットワークを確認して、ページを読み込み直してください。'; }, 15000);
</script>
