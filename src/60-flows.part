// =====================================================================
// 60 flows : 旅客・手荷物・トーイングトラクターを InstancedMesh で描く（表示中のモードのシミュレーションを読む）
// =====================================================================
const PAX_MAX = 5000, BAG_MAX = 5000, TUG_MAX = 24;
const PAX_KEYS = ['pax', 'pax-q', 'pax-x', 'pax-arr'], BAG_KEYS = ['bag', 'bag-re', 'bag-ng', 'bag-ebs', 'bag-arr'];
let paxMesh, bagMesh, tugMesh, dollyMesh, paxGlow, bagGlow, paxMatLit, paxMatFlat, bagMatLit, bagMatFlat;
const paxRGB = new Float32Array(12), bagRGB = new Float32Array(15);
function initInstanced(mesh, max, sx, sy, sz) {
  const m = mesh.instanceMatrix.array; for (let i = 0; i < max; i++) { const o = i * 16; m[o] = sx; m[o + 5] = sy; m[o + 10] = sz; m[o + 15] = 1; }
  mesh.setColorAt(0, new THREE.Color(1, 1, 1)); mesh.instanceMatrix.setUsage(THREE.DynamicDrawUsage); mesh.instanceColor.setUsage(THREE.DynamicDrawUsage);
  mesh.frustumCulled = false; mesh.count = 0;
}
function glowPoints(max, size) {
  const g = new THREE.BufferGeometry();
  g.setAttribute('position', new THREE.BufferAttribute(new Float32Array(max * 3), 3).setUsage(THREE.DynamicDrawUsage));
  g.setAttribute('color', new THREE.BufferAttribute(new Float32Array(max * 3), 3).setUsage(THREE.DynamicDrawUsage));
  const p = new THREE.Points(g, new THREE.PointsMaterial({ size, map: dotTex, vertexColors: true, transparent: true, opacity: 0.42, depthWrite: false, blending: THREE.AdditiveBlending, sizeAttenuation: true }));
  p.frustumCulled = false; p.renderOrder = 5; g.setDrawRange(0, 0); return p;
}
function buildFlows() {
  paxMatLit = new THREE.MeshLambertMaterial(); paxMatFlat = new THREE.MeshBasicMaterial({ transparent: false });
  bagMatLit = new THREE.MeshLambertMaterial(); bagMatFlat = new THREE.MeshBasicMaterial();
  paxMesh = new THREE.InstancedMesh(lowPower ? new THREE.CapsuleGeometry(0.36, 0.95, 1, 5) : new THREE.CapsuleGeometry(0.36, 0.95, 2, 7), paxMatLit, PAX_MAX); initInstanced(paxMesh, PAX_MAX, 1, 1, 1);
  bagMesh = new THREE.InstancedMesh(new THREE.BoxGeometry(1.3, 0.85, 1.0), bagMatLit, BAG_MAX); initInstanced(bagMesh, BAG_MAX, 1, 1, 1);
  const mTug = M('sign', { roughness: 0.7 }), mDolly = M('s-edge');
  tugMesh = new THREE.InstancedMesh(mergeGeometries([new THREE.BoxGeometry(1.5, 0.9, 2.6).translate(0, 0.75, 0), new THREE.BoxGeometry(1.3, 0.7, 1.0).translate(0, 1.5, -0.5)]), mTug, TUG_MAX);
  dollyMesh = new THREE.InstancedMesh(mergeGeometries([new THREE.BoxGeometry(1.9, 0.22, 2.9).translate(0, 0.55, 0), new THREE.BoxGeometry(1.9, 0.5, 0.1).translate(0, 0.9, 1.4), new THREE.BoxGeometry(1.9, 0.5, 0.1).translate(0, 0.9, -1.4)]), mDolly, TUG_MAX * 4);
  for (const m of [tugMesh, dollyMesh]) { m.instanceMatrix.setUsage(THREE.DynamicDrawUsage); m.frustumCulled = false; m.count = 0; }
  paxGlow = glowPoints(PAX_MAX, 3.4); bagGlow = glowPoints(BAG_MAX, 4.6); bagGlow.material.opacity = 0.6;
  world3d.add(paxMesh, bagMesh, tugMesh, dollyMesh, paxGlow, bagGlow);
  themeHooks.push(() => {
    PAX_KEYS.forEach((k, i) => TH.c[k].toArray(paxRGB, i * 3)); BAG_KEYS.forEach((k, i) => TH.c[k].toArray(bagRGB, i * 3));
    // 夜は発光（陰影なし + 加算のにじみ）、昼は模型に刺したピンのように陰影をつける
    paxMesh.material = TH.dark ? paxMatFlat : paxMatLit; bagMesh.material = TH.dark ? bagMatFlat : bagMatLit;
    paxGlow.visible = bagGlow.visible = TH.dark; applyGhostToFlows();
  });
}
function applyGhostToFlows() {
  for (const m of [paxMatLit, paxMatFlat]) { m.transparent = upperGhost > 0.02; m.opacity = lerp(1, 0.16, upperGhost); m.depthWrite = upperGhost < 0.5; m.needsUpdate = true; }
  if (paxGlow) paxGlow.material.opacity = lerp(0.42, 0.06, upperGhost);
  if (HEAT.mesh) HEAT.mesh.material.opacity = lerp(TH.dark ? 0.8 : 1, 0.12, upperGhost);
}
const _d = new THREE.Object3D(), _pose = { x: 0, z: 0, hx: 0, hz: 0 };
function bridgeY(a, f) {           // 搭乗橋の上では機体ドアの高さへ下る
  if (a.z > LAY.ZA || LAY.gates[f.gate].remote) return YU;
  return lerp(YU, DOOR_Y, clamp((LAY.ZA - a.z) / 31.5, 0, 1));
}
function updateFlows(sim) {
  const t = sim.t;
  // ---- 旅客 ----
  let arr = sim.pax, n = Math.min(arr.length, PAX_MAX), m = paxMesh.instanceMatrix.array, col = paxMesh.instanceColor.array;
  const gp = paxGlow.geometry.attributes.position.array, gc = paxGlow.geometry.attributes.color.array, dark = TH.dark;
  for (let i = 0; i < n; i++) {
    const a = arr[i], st = a.st; let y = YU, k = a.kind;
    if (k === 3) { if (a.lvl) y = 0; else if (a.z < LAY.ZA) y = bridgeY(a, a.f); else if (a.x < -160 && a.z > 58) y = lerp(YU, 0, clamp((a.z - 58) / 8, 0, 1)); }
    else {
      if (st === S.BOARD) y = bridgeY(a, a.f);
      if (k === 0 && (st === S.Q_SEC || st === S.Q_DROP || st === S.Q_IMM) && t - a.t0 > 3) k = 1;
    }
    const o = i * 16, c = i * 3, kc = k * 3; m[o + 12] = a.x; m[o + 13] = y + 0.84; m[o + 14] = a.z;
    col[c] = paxRGB[kc]; col[c + 1] = paxRGB[kc + 1]; col[c + 2] = paxRGB[kc + 2];
    if (dark) { gp[c] = a.x; gp[c + 1] = y + 1.2; gp[c + 2] = a.z; gc[c] = paxRGB[kc]; gc[c + 1] = paxRGB[kc + 1]; gc[c + 2] = paxRGB[kc + 2]; }
  }
  paxMesh.count = n; paxMesh.instanceMatrix.needsUpdate = true; paxMesh.instanceColor.needsUpdate = true;
  if (dark) { paxGlow.geometry.setDrawRange(0, n); paxGlow.geometry.attributes.position.needsUpdate = true; paxGlow.geometry.attributes.color.needsUpdate = true; }
  // ---- 手荷物 ----
  arr = sim.bags; n = Math.min(arr.length, BAG_MAX); m = bagMesh.instanceMatrix.array; col = bagMesh.instanceColor.array;
  const bp = bagGlow.geometry.attributes.position.array, bc = bagGlow.geometry.attributes.color.array;
  for (let i = 0; i < n; i++) {
    const b = arr[i], o = i * 16, c = i * 3, kc = (b.missed ? 2 : b.c) * 3; m[o + 12] = b.x; m[o + 13] = b.y; m[o + 14] = b.z;
    col[c] = bagRGB[kc]; col[c + 1] = bagRGB[kc + 1]; col[c + 2] = bagRGB[kc + 2];
    if (dark) { bp[c] = b.x; bp[c + 1] = b.y + 0.3; bp[c + 2] = b.z; const dim = b.c === 3 ? 0.35 : 1; bc[c] = bagRGB[kc] * dim; bc[c + 1] = bagRGB[kc + 1] * dim; bc[c + 2] = bagRGB[kc + 2] * dim; }
  }
  bagMesh.count = n; bagMesh.instanceMatrix.needsUpdate = true; bagMesh.instanceColor.needsUpdate = true;
  if (dark) { bagGlow.geometry.setDrawRange(0, n); bagGlow.geometry.attributes.position.needsUpdate = true; bagGlow.geometry.attributes.color.needsUpdate = true; }
  // ---- トーイングトラクターとドーリー ----
  let ti = 0, di = 0;
  for (const list of [sim.tugs, sim.arrTugs]) for (const tug of list) {
    if (ti >= TUG_MAX) break;
    tugPose(tug, 0, _pose); _d.position.set(_pose.x, 0, _pose.z); _d.rotation.y = Math.atan2(_pose.hx, _pose.hz); _d.updateMatrix(); tugMesh.setMatrixAt(ti++, _d.matrix);
    for (let k = 0; k < 4; k++) { tugPose(tug, 3.6 + k * 3.3, _pose); _d.position.set(_pose.x, 0, _pose.z); _d.rotation.y = Math.atan2(_pose.hx, _pose.hz); _d.updateMatrix(); dollyMesh.setMatrixAt(di++, _d.matrix); }
  }
  tugMesh.count = ti; dollyMesh.count = di; tugMesh.instanceMatrix.needsUpdate = true; dollyMesh.instanceMatrix.needsUpdate = true;
  // ---- 稼働灯 ----
  const cOn = TH.c['good'], cOff = TH.c['s-edge'], cBad = TH.c['bad'];
  for (let c = 0; c < 3; c++) { const cp = sim.cp[c], open = Math.min(cp.open, cp.limit); for (let j = 0; j < 6; j++) laneLights.setColorAt(c * 6 + LANE_ORDER[j], j < open ? cOn : (cp.limit < 99 && j < cp.open ? cBad : cOff)); }
  laneLights.instanceColor.needsUpdate = true;
  for (let l = 0; l < 3; l++) edsLights.setColorAt(l, sim.scn.edsDown === l ? cBad : cOn);
  edsLights.instanceColor.needsUpdate = true;
}
