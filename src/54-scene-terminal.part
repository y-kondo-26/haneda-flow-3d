// =====================================================================
// 54 scene (ターミナル上階) : 屋根を外したカットアウェイ。出発ロビー → 保安検査 → 出国審査 → コンコース → ゲート
// =====================================================================
const mSlab = M('s-slab', { transparent: true, opacity: 0.6, depthWrite: false, side: THREE.DoubleSide });
const mUp = M('s-bldg', { transparent: true }), mUp2 = M('s-bldg2', { transparent: true }), mUpEdge = M('s-edge', { transparent: true }), mUpMachine = M('s-machine', { transparent: true });
const mUpGlass = M('s-glass', { transparent: true, opacity: 0.4, depthWrite: false });
const mRoof = M('s-edge', { transparent: true, opacity: 0.55 });
for (const m of [mSlab, mUpGlass, mRoof, mGlass, mMark]) m.userData.noShadow = true;
const upperMats = [mUp, mUp2, mUpEdge, mUpMachine];
let laneLights = null;

function buildUpper() {
  const { X0, X1, ZA, ZL } = LAY, W = X1 - X0, Dp = ZL - ZA, cx = 0, cz = (ZA + ZL) / 2;
  // 床スラブ（半透明。下階の手荷物の流れが透けて見える）
  const slab = new THREE.Mesh(new THREE.BoxGeometry(W, 0.5, Dp).translate(cx, YU - 0.27, cz), mSlab); slab.renderOrder = 2; slab.receiveShadow = true; gUpper.add(slab);
  // 外周の腰壁とランドサイドのガラス面
  box(mUp, W, 2.2, 0.8, cx, YU + 1.1, ZL); box(mUp, 0.8, 2.2, Dp, X0, YU + 1.1, cz); box(mUp, 0.8, 2.2, Dp - 30, X1, YU + 1.1, cz - 15 + 2);
  box(mUpGlass, W, 9, 0.3, cx, YU + 6.6, ZL + 0.2); box(mUpGlass, W, 4.4, 0.3, cx, YU + 2.2, ZA);
  for (let x = X0; x <= X1; x += 21.5) box(mUpEdge, 0.7, 11, 0.7, x, YU + 5.5, ZL + 0.2);
  // 入口（3 か所）と駅連絡通路
  for (const d of LAY.doors) {
    if (d.station) { box(mUp, 26, 0.5, 10, X1 + 13, YU - 0.25, d.z); box(mUpGlass, 26, 3.2, 0.3, X1 + 13, YU + 1.6, d.z - 5); box(mUpGlass, 26, 3.2, 0.3, X1 + 13, YU + 1.6, d.z + 5); }
    else { box(mUp, 16, 0.6, 9, d.x, YU + 4.4, ZL + 4.6); box(mUpEdge, 0.5, 4.6, 0.5, d.x - 7.5, YU + 2.2, ZL + 8.6); box(mUpEdge, 0.5, 4.6, 0.5, d.x + 7.5, YU + 2.2, ZL + 8.6); }
  }
  // 大屋根は骨組みだけを残す
  for (let x = X0 + 14; x < X1; x += 43) { box(mRoof, 0.9, 0.9, Dp + 16, x, YU + 19, cz + 4); box(mRoof, 0.7, 7, 0.7, x, YU + 15.5, ZL + 0.2); box(mRoof, 0.7, 14.5, 0.7, x, YU + 11.7, ZA); }
  box(mRoof, W, 0.7, 0.7, cx, YU + 19, ZL + 12); box(mRoof, W, 0.7, 0.7, cx, YU + 19, ZA - 4); box(mRoof, W, 0.5, 0.5, cx, YU + 19, cz);
  // チェックイン島と自動手荷物預け機
  LAY.islands.forEach((is, i) => {
    const len = is.z1 - is.z0;
    box(mUp, 5.2, 1.0, len, is.x, YU + 0.5, is.z0 + len / 2); box(mBelt, 1.5, 0.16, len + 1.2, is.x, YU + 1.08, is.z0 + len / 2 - 0.6);
    for (let k = 0; k < LAY.dropsPerIsland; k++) { const kp = kioskPos(i, k), sx = k % 2 ? -1 : 1; box(mUpMachine, 1.5, 1.5, 1.3, kp.x + sx * 1.35, YU + 0.75, kp.z); box(mUpEdge, 0.2, 1.1, 0.9, kp.x + sx * 0.5, YU + 1.95, kp.z); }
    box(mUpEdge, 0.5, 6.4, 0.5, is.x, YU + 3.2, is.z1 + 0.9); box(mUp2, 4.4, 1.9, 0.5, is.x, YU + 6.6, is.z1 + 0.9);
    addLabel(`チェックイン <span class="num">${is.name}</span><small data-live="isl${i}"></small>`, is.x, YU + 9.5, is.z1 + 0.9, '', 2);
  });
  addLabel('出発ロビー<small>自動手荷物預け機 60 台</small>', -150, YU + 9, 76, 'major', 1);
  // ランドサイドとエアサイドを分ける壁と、保安検査場（スマートレーン 6 本 × 3 か所）
  const gaps = LAY.cps.map(c => [c.x - 14.4, c.x + 14.4]); let px = X0;
  for (const [a, b] of gaps.concat([[X1, X1]])) { if (a > px) box(mUp, a - px, 3.4, 0.6, (a + px) / 2, YU + 1.7, 34); px = b; }
  LAY.cps.forEach((cp, c) => {
    for (let l = 0; l < LAY.cpLanes; l++) {
      const x = laneX(c, l);
      box(mUp2, 1.1, 0.85, 12.6, x + 1.25, YU + 0.43, 34.2);                         // トレーの搬送テーブル
      box(mUpMachine, 1.5, 1.7, 3.2, x + 1.25, YU + 1.15, 34); box(mUpEdge, 1.52, 0.5, 3.3, x + 1.25, YU + 2.15, 34);   // X 線検査装置
      box(mUpEdge, 0.16, 2.3, 0.5, x - 0.95, YU + 1.15, 33); box(mUpEdge, 0.16, 2.3, 0.5, x + 0.35, YU + 1.15, 33); box(mUpEdge, 1.46, 0.16, 0.5, x - 0.3, YU + 2.3, 33);   // ボディスキャナー
    }
    box(mUp, 0.5, 2.6, 15, cp.x - 14.4, YU + 1.3, 34); box(mUp, 0.5, 2.6, 15, cp.x + 14.4, YU + 1.3, 34);
    for (let r = 0; r < 4; r++) box(mUpEdge, 27, 0.9, 0.12, cp.x, YU + 0.45, LAY.zQ - 0.65 + r * 1.3);      // 行列の仕切り
    addLabel(`保安検査場 <span class="num">${cp.name}</span><small data-live="cp${c}"></small>`, cp.x, YU + 8, 43, 'major', 1, 2);
    // 出国審査（顔認証ゲート）
    for (let k = 0; k < LAY.immGates; k++) { const x = cp.x + (k - 3) * 2.6; box(mUpMachine, 0.5, 1.2, 2.4, x - 1.1, YU + 0.6, LAY.zImm); box(mUpGlass, 0.9, 1.0, 0.12, x - 0.4, YU + 0.7, LAY.zImm - 0.6); }
    box(mUpMachine, 0.5, 1.2, 2.4, cp.x + 9.2 - 1.1 + 2.6 - 1.5, YU + 0.6, LAY.zImm);
    box(mUp, 2.6 * 7 + 2, 0.3, 3.4, cp.x - 0.4, YU + 3.3, LAY.zImm); box(mUpEdge, 0.3, 3.2, 0.3, cp.x - 10, YU + 1.6, LAY.zImm); box(mUpEdge, 0.3, 3.2, 0.3, cp.x + 9.2, YU + 1.6, LAY.zImm);
    addLabel(`出国審査 <span class="num">${cp.name}</span><small>顔認証ゲート ${LAY.immGates} 台</small>`, cp.x + 17, YU + 5.5, LAY.zImm, '', 2);
  });
  px = X0;
  for (const [a, b] of LAY.cps.map(c => [c.x - 10.2, c.x + 9.4]).concat([[X1, X1]])) { if (a > px) box(mUp, a - px, 3.0, 0.5, (a + px) / 2, YU + 1.5, LAY.zImm - 1.6); px = b; }
  // コンコース: ゲートラウンジの椅子・ゲートカウンター
  LAY.gates.forEach((g, gi) => {
    if (g.remote) { box(mUpMachine, 5, 1.1, 1, g.x + 9, YU + 0.55, -11.6); addLabel(`バスゲート <span class="num">${g.no}</span><small data-live="gate${gi}"></small>`, g.x + 9, YU + 6, -12, 'gate', 2); return; }
    for (let r = 0; r < 4; r++) for (const sx of [-9.5, 0, 9.5]) box(mUp2, 7.6, 0.55, 0.8, g.x + sx - 2, YU + 0.28, -9 + r * 3.6);
    box(mUpMachine, 4.6, 1.1, 1, g.x + 8, YU + 0.55, -11.2); box(mUpEdge, 0.3, 4.2, 0.3, g.x + 12, YU + 2.1, -12.8); box(mUp2, 2.6, 1.3, 0.3, g.x + 12, YU + 4.4, -12.8);
    addLabel(`ゲート <span class="num">${g.no}</span><small data-live="gate${gi}"></small>`, g.x + 12, YU + 7.2, -12.8, 'gate', 2);
  });
  for (let x = X0 + 40; x < X1 - 20; x += 80) box(mUp2, 30, 0.12, 2.6, x, YU + 0.07, 6.4);                 // 動く歩道
  addLabel('制限エリア コンコース', -40, YU + 6, 4, '', 3);
  // 到着旅客の通路（西端）と下階への階段
  addGeo(mUp2, new THREE.BoxGeometry(3.8, 0.3, 14.5).rotateX(0.983).translate(-168, YU / 2, 62)); box(mUpEdge, 0.3, 1.2, 80, -170.2, YU + 0.6, 22);
  addLabel('到着通路', -168, YU + 4.5, 20, '', 3);
  const meshes = flush(gUpper, { cast: true, receive: true, order: 1 });
  for (const m of meshes) if (m.material === mUpGlass || m.material === mRoof) m.renderOrder = 3;
  // レーンの稼働灯（開いているレーンだけ点灯）
  laneLights = new THREE.InstancedMesh(new THREE.BoxGeometry(1.6, 0.35, 0.5), new THREE.MeshBasicMaterial(), 18);
  const m4 = new THREE.Matrix4();
  for (let c = 0; c < 3; c++) for (let l = 0; l < 6; l++) { m4.makeTranslation(laneX(c, l) + 0.2, YU + 3.1, LAY.zLaneIn - 0.4); laneLights.setMatrixAt(c * 6 + l, m4); laneLights.setColorAt(c * 6 + l, new THREE.Color(0x888888)); }
  laneLights.renderOrder = 4; gUpper.add(laneLights);
  for (let c = 0; c < 3; c++) for (let l = 0; l < 6; l++) box(mUpEdge, 0.14, 3.2, 0.14, laneX(c, l) + 0.2, YU + 1.6, LAY.zLaneIn - 0.4);
  flush(gUpper, { cast: false, receive: false, order: 1 });
}
// 「上階を透かす」: 上階の造作と旅客を薄くして、下階の手荷物ホールを見せる
let upperGhost = 0, upperGhostTarget = 0;
function setUpperOpacity(k) {     // k: 0 = 通常、1 = 透かす
  mSlab.opacity = lerp(TH.dark ? 0.5 : 0.62, 0.07, k);
  for (const m of upperMats) { m.opacity = lerp(1, 0.13, k); m.depthWrite = k < 0.5; }
  mUpGlass.opacity = lerp(0.4, 0.06, k); mRoof.opacity = lerp(0.55, 0.08, k);
}
