<style>
@media (max-width: 1380px) { #ident .ttl { display: none; } }
@media (max-width: 1180px) { :root { --panel-w: 344px; } #modeSwitch button { min-width: 112px; padding-inline: 10px; } }
@media (min-width: 861px) and (max-height: 760px) { .chart canvas { height: 84px; } }

/* ---- スマホ幅: 上に舞台、下に計器盤のシート（タブ切替）---- */
@media (max-width: 860px) {
  #app { grid-template-columns: minmax(0, 1fr); grid-template-rows: minmax(250px, 46%) minmax(0, 1fr); }
  #topBar { top: 8px; right: max(16px, env(safe-area-inset-right, 0px)); display: flex; flex-direction: column-reverse; gap: 6px; align-items: stretch; }
  #ident { align-self: flex-start; }
  #ticker { display: none; }
  #modeSwitch button { flex: 1; min-width: 0; font-size: 13px; padding: 6px 4px 5px; }
  #ident .ttl { display: none; }
  #ident .code { padding: 4px 7px 3px; } #ident .code b { font-size: 15px; } #ident .code span { font-size: 8.5px; }
  #ident .clock { padding: 2px 8px 1px; border-left: 0; } #clock { font-size: 17px; } #ident .clock span { font-size: 9px; }
  #stageWrap > #legend { display: none; }
  #dock { left: 0; right: 0; bottom: 6px; gap: 5px; padding-left: max(16px, env(safe-area-inset-left, 0px)); padding-right: max(16px, env(safe-area-inset-right, 0px)); }
  #dock .bar { flex-wrap: nowrap; overflow-x: auto; scrollbar-width: none; width: 100%; }
  #dock .bar::-webkit-scrollbar { display: none; }
  #dock .bar .cap { display: none; }
  .chip { padding: 6px 9px 5px; min-height: 32px; font-size: 12px; }
  #caption { padding: 7px 10px 6px; } #caption b { font-size: 12px; } #caption span { font-size: 11px; }
  #toast { top: 104px; left: auto; right: max(16px, env(safe-area-inset-right, 0px)); transform: none; max-width: 62%; font-size: 11.5px; }
  .lbl { font-size: 10px; padding: 1px 4px; } .lbl.major { font-size: 10.5px; } .lbl small { font-size: 9px; }

  #panel { border-left: 0; border-top: 1px solid var(--line); }
  #tabs { display: flex; border-bottom: 1px solid var(--line); padding: 0 max(16px, env(safe-area-inset-right, 0px)) 0 max(16px, env(safe-area-inset-left, 0px)); flex: none; }
  #tabs button { flex: 1; font-size: 12.5px; font-weight: 700; padding: 9px 2px 7px; color: var(--ink-2); border-bottom: 3px solid transparent; margin-bottom: -1px; min-height: 40px; }
  #tabs button[aria-selected="true"] { color: var(--ink); border-bottom-color: var(--sign); }
  #panelBody { padding: 10px max(16px, env(safe-area-inset-right, 0px)) 12px max(16px, env(safe-area-inset-left, 0px)); gap: 10px; }
  #panel .sec { display: none; }
  #panel[data-tab="kpi"] #secKpi, #panel[data-tab="chart"] #secChart, #panel[data-tab="log"] #secLog, #panel[data-tab="ctl"] #secCtl { display: block; }
  #secCtl .bar { background: none; border: 0; padding: 0; backdrop-filter: none; -webkit-backdrop-filter: none; gap: 6px; margin-bottom: 12px; }
  #secCtl .bar .cap { flex-basis: 100%; padding: 0; font-size: 11px; font-weight: 700; }
  #secCtl .bar .sep { display: none; }
  #secCtl .chip { border-color: var(--line); min-height: 36px; padding-inline: 12px; }
  #secCtl #legend { position: static; background: none; border: 0; padding: 0; backdrop-filter: none; -webkit-backdrop-filter: none; font-size: 12px; }
  #secCtl #legend summary { font-size: 11px; color: var(--ink-2); }
  #secCtl #ctlBars { display: block; }
  #note { font-size: 10px; padding: 5px max(16px, env(safe-area-inset-right, 0px)) calc(5px + env(safe-area-inset-bottom, 0px)) max(16px, env(safe-area-inset-left, 0px)); }
  #note span { display: none; }
  #headline strong { font-size: 15px; } #headline strong em { font-size: 22px; }
  .chart canvas { height: 96px; }
}
@media (max-width: 860px) and (max-height: 560px) { #app { grid-template-rows: minmax(200px, 52%) minmax(0, 1fr); } #ident { display: none; } }
@media (prefers-reduced-motion: reduce) { #worldFlash.on { animation: none; } .lbl, #toast { transition: none; } }
</style>
